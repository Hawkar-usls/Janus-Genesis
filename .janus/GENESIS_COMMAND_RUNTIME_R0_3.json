    "GENESIS_VALIDATOR_REQUIRED",
    "FIRST_PERSON_FORWARD_EQ_CAMERA_FORWARD_ON_GROUND_PLANE",
    "FIRST_PERSON_HORIZON_AUTO_LEVEL",
    "ASSET_REFERENCE_NE_CANONICAL_BINARY",
    "RIGHTS_GATE_BEFORE_EXTERNAL_ASSET_USE",
