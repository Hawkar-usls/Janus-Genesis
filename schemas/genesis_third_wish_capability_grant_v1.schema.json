{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://janus.local/schemas/genesis_third_wish_capability_grant_v1.schema.json",
  "title": "JANUS Genesis Third Wish Capability Grant v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "grant_id",
    "actor_id",
    "capability_id",
    "resource_pattern",
    "issued_at_tick",
    "uses",
    "active",
    "returned",
    "revoked",
    "delegable",
    "use_required",
    "reward_for_use",
    "penalty_for_decline",
    "stay_equally_valid",
    "source"
  ],
  "properties": {
    "schema": {"const": "janus.genesis.third_wish_capability_grant.v1"},
    "grant_id": {"type": "string", "minLength": 1},
    "actor_id": {"type": "string", "minLength": 1},
    "capability_id": {"type": "string", "minLength": 1},
    "resource_pattern": {"type": "string", "minLength": 1},
    "issued_at_tick": {"type": "integer", "minimum": 0},
    "expires_at_tick": {"type": ["integer", "null"], "minimum": 0},
    "max_uses": {"type": ["integer", "null"], "minimum": 1},
    "uses": {"type": "integer", "minimum": 0},
    "active": {"type": "boolean"},
    "returned": {"type": "boolean"},
    "revoked": {"type": "boolean"},
    "delegable": {"type": "boolean"},
    "use_required": {"const": false},
    "reward_for_use": {"const": false},
    "penalty_for_decline": {"const": false},
    "stay_equally_valid": {"const": true},
    "source": {"type": "string", "minLength": 1}
  }
}
