{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hawkar-usls/Janus_Genesis/schemas/genesis_audio_recipe_v1.schema.json",
  "title": "JANUS Genesis Audio Recipe v1",
  "type": "object",
  "required": ["schema", "generator", "generator_version", "recipe_id", "tempo_bpm", "root_midi", "scale", "motif", "layers"],
  "properties": {
    "schema": {"const": "janus.genesis.audio_recipe.v1"},
    "generator": {"const": "GENESIS_AUDIO_FORGE_V1"},
    "generator_version": {"type": "string", "minLength": 1, "maxLength": 40},
    "recipe_id": {"type": "string", "pattern": "^genesis://audio/[A-Za-z0-9._/-]+$", "maxLength": 180},
    "tempo_bpm": {"type": "number", "minimum": 36, "maximum": 160},
    "root_midi": {"type": "integer", "minimum": 24, "maximum": 84},
    "scale": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "integer", "minimum": -24, "maximum": 24}},
    "motif": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "integer", "minimum": -32, "maximum": 32}},
    "layers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pulse": {"$ref": "#/$defs/layer"},
        "bass": {"$ref": "#/$defs/layer"},
        "arp": {"$ref": "#/$defs/layer"},
        "pad": {"$ref": "#/$defs/layer"},
        "bells": {"$ref": "#/$defs/layer"},
        "drone": {"$ref": "#/$defs/layer"},
        "noise": {"$ref": "#/$defs/layer"}
      }
    },
    "world_bindings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entropy": {"type": "string", "maxLength": 80},
        "depth": {"type": "string", "maxLength": 80},
        "portal_energy": {"type": "string", "maxLength": 80},
        "danger": {"type": "string", "maxLength": 80},
        "weather_intensity": {"type": "string", "maxLength": 80}
      }
    }
  },
  "$defs": {
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "density": {"type": "number", "minimum": 0, "maximum": 1},
        "gain": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.2},
        "wave": {"enum": ["sine", "triangle", "square", "sawtooth"]}
      }
    }
  },
  "additionalProperties": false
}
