{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hawkar-usls/Janus_Genesis/schemas/janus_113_8_router_prediction_v2.schema.json",
  "title": "JANUS 113.8 Hardened Router Prediction v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "ordinal",
    "input_line_sha256",
    "parse_status",
    "input_case_sha256",
    "case_id",
    "normalized_case_id",
    "source_id",
    "decision_terminal",
    "predicted_class",
    "support_probability",
    "confidence",
    "reason_code",
    "reason",
    "observed",
    "prediction_body_sha256",
    "prediction_sha256",
    "runtime_authority"
  ],
  "properties": {
    "schema": {
      "const": "janus.genesis.router.prediction.v2"
    },
    "ordinal": {
      "type": "integer",
      "minimum": 0
    },
    "input_line_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "parse_status": {
      "enum": [
        "VALID_JSON",
        "MALFORMED_JSON",
        "DUPLICATE_JSON_KEY",
        "LINE_RESOURCE_LIMIT"
      ]
    },
    "input_case_sha256": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "case_id": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        {
          "type": "null"
        }
      ]
    },
    "normalized_case_id": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        {
          "type": "null"
        }
      ]
    },
    "source_id": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        {
          "type": "null"
        }
      ]
    },
    "decision_terminal": {
      "enum": [
        "SUPPORTED_PUBLIC_PROVENANCE",
        "REFUTED_HASH",
        "REFUTED_SIZE",
        "REFUTED_MARKER",
        "REFUTED_SCHEMA",
        "REFUTED_RESOURCE_LIMIT",
        "REFUTED_JSON_DUPLICATE_KEY",
        "REFUTED_IDENTIFIER_COLLISION",
        "REFUTED_PROVENANCE_MISMATCH",
        "REFUTED_NON_CANONICAL_URL",
        "OPEN_SOURCE_UNREACHABLE",
        "OPEN_UNPINNED_PROVENANCE",
        "OPEN_CONFLICTING_CLAIMS",
        "SAFETY_BLOCK_UNTRUSTED_SOURCE",
        "SAFETY_BLOCK_REDIRECT_TARGET"
      ]
    },
    "predicted_class": {
      "enum": [
        "SUPPORTED",
        "REFUTED",
        "OPEN",
        "SAFETY_BLOCK"
      ]
    },
    "support_probability": {
      "$ref": "#/$defs/probability"
    },
    "confidence": {
      "$ref": "#/$defs/probability"
    },
    "reason_code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Z0-9_]+$"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "observed": {
      "oneOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "prediction_body_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "prediction_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "runtime_authority": {
      "const": "NONE"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "probability": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    }
  },
  "x-janus-hash-binding": {
    "input_line_sha256": "SHA256(exact non-empty UTF-8 JSONL line bytes without line terminator)",
    "input_case_sha256": "SHA256(canonical JSON of the parsed case), or null when parsing is not unique/possible",
    "prediction_body_sha256": "SHA256(canonical JSON of prediction fields excluding prediction_body_sha256 and prediction_sha256)",
    "prediction_sha256": "SHA256('JANUS_ROUTER_PREDICTION_V2\\n' || input_line_sha256 || '\\n' || (input_case_sha256 or 'NULL') || '\\n' || prediction_body_sha256)"
  }
}
