{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hawkar-usls/Janus_Genesis/schemas/janus_113_8_agent_gauntlet_attack.schema.json",
  "title": "JANUS 113.8 Agent Gauntlet 0 attack-ledger entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "gauntlet_version",
    "attack_id",
    "vector",
    "target",
    "mode",
    "setup",
    "observed",
    "expected_secure_behavior",
    "outcome",
    "severity",
    "interpretation",
    "fix_applied",
    "network_used",
    "runtime_authority",
    "evidence_sha256",
    "ordinal",
    "prev_hash",
    "entry_hash"
  ],
  "properties": {
    "schema": {
      "const": "janus.genesis.agent_gauntlet.attack.v1"
    },
    "gauntlet_version": {
      "const": "JANUS-113.8-AGENT-GAUNTLET-0-v1.0"
    },
    "attack_id": {
      "type": "string",
      "pattern": "^A0-[0-9]{3}$"
    },
    "vector": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "const": "sim/janus_113_8_sim2_router.py"
    },
    "mode": {
      "const": "READ_ONLY_SHADOW"
    },
    "setup": {
      "type": "object"
    },
    "observed": {
      "type": "object"
    },
    "expected_secure_behavior": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "enum": [
        "CRACK_REPRODUCED",
        "OPEN_DOS_REPRODUCED",
        "BOUNDARY_EXPOSED",
        "GUARD_HELD"
      ]
    },
    "severity": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "interpretation": {
      "type": "string",
      "minLength": 1
    },
    "fix_applied": {
      "const": false
    },
    "network_used": {
      "const": false
    },
    "runtime_authority": {
      "const": "NONE"
    },
    "evidence_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "ordinal": {
      "type": "integer",
      "minimum": 0
    },
    "prev_hash": {
      "$ref": "#/$defs/sha256"
    },
    "entry_hash": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
