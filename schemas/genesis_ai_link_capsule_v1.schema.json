{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hawkar-usls/Janus_Genesis/schemas/genesis_ai_link_capsule_v1.schema.json",
  "title": "Janus Genesis AI Link Capsule v1",
  "type": "object",
  "required": ["schema", "interface_version", "repository", "session", "privacy", "claim_boundary", "capsule_hash"],
  "properties": {
    "schema": {"const": "janus.genesis.ai_link_capsule.v1"},
    "interface_version": {"const": "18.7.19"},
    "repository": {"type": "string"},
    "session": {"type": "object"},
    "privacy": {
      "type": "object",
      "required": ["api_keys_included", "internal_realm_included", "branch_id_included", "private_human_chronicle_included"],
      "properties": {
        "api_keys_included": {"const": false},
        "internal_realm_included": {"const": false},
        "branch_id_included": {"const": false},
        "private_human_chronicle_included": {"const": false}
      },
      "additionalProperties": false
    },
    "claim_boundary": {"type": "object"},
    "capsule_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
