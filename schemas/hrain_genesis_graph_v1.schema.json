{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hawkar-usls/Janus_Genesis/schemas/hrain_genesis_graph_v1.schema.json",
  "title": "HRaiN Genesis Semantic Graph v1",
  "type": "object",
  "required": [
    "schema_version",
    "canonical_seed_sha256",
    "backend",
    "nodes",
    "edges",
    "players",
    "invariants"
  ],
  "properties": {
    "schema_version": {"const": "HRAIN-GENESIS-GRAPH-v1"},
    "canonical_seed_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "backend": {
      "type": "object",
      "required": ["kind", "canonical_database_connected"],
      "properties": {
        "kind": {"enum": ["json_sidecar", "sqlite", "postgresql", "janusgraph"]},
        "canonical_database_connected": {"type": "boolean"},
        "canonical_database_name": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "nodes": {
      "type": "array",
      "items": {"$ref": "#/$defs/node"}
    },
    "edges": {
      "type": "array",
      "items": {"$ref": "#/$defs/edge"}
    },
    "players": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["facets", "facet_evidence", "possibilities"],
        "properties": {
          "facets": {
            "type": "array",
            "items": {"type": "string"},
            "uniqueItems": true
          },
          "facet_evidence": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {"type": "string"}
            }
          },
          "possibilities": {
            "type": "array",
            "items": {"type": "string"},
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "invariants": {
      "type": "object",
      "required": [
        "good_is_not_currency",
        "moral_rank_required",
        "possibilities_can_be_reopened",
        "harm_permanently_erases_possibility",
        "changes_god_mode_law",
        "changes_moral_routing",
        "claims_simulated_residents_are_conscious"
      ],
      "properties": {
        "good_is_not_currency": {"const": true},
        "moral_rank_required": {"const": false},
        "possibilities_can_be_reopened": {"const": true},
        "harm_permanently_erases_possibility": {"const": false},
        "changes_god_mode_law": {"const": false},
        "changes_moral_routing": {"const": false},
        "claims_simulated_residents_are_conscious": {"const": false}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "node": {
      "type": "object",
      "required": [
        "id",
        "type",
        "source",
        "created_at",
        "confidence",
        "integrity_hash",
        "mutable",
        "payload"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {
          "enum": [
            "PLAYER",
            "ACTION",
            "EVIDENCE",
            "PLACE",
            "CAPABILITY",
            "POSSIBILITY",
            "RESIDENT",
            "OATH",
            "MEMORY",
            "DEVICE",
            "STORY",
            "SYSTEM",
            "PROVENANCE",
            "EXTERNAL_LEXICON",
            "TOKEN",
            "CONCEPT"
          ]
        },
        "source": {"type": "string", "minLength": 1},
        "created_at": {"type": "integer", "minimum": 0},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "integrity_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "mutable": {"type": "boolean"},
        "payload": {"type": "object"}
      },
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "required": [
        "id",
        "from",
        "to",
        "relation",
        "evidence",
        "confidence",
        "created_by",
        "created_at",
        "reversible",
        "integrity_hash",
        "payload"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "from": {"type": "string", "minLength": 1},
        "to": {"type": "string", "minLength": 1},
        "relation": {
          "enum": [
            "REMEMBERS",
            "OBSERVED",
            "CAUSED",
            "CONFIRMED",
            "CONTRADICTS",
            "PROTECTS",
            "CREATED",
            "DEPENDS_ON",
            "INHERITED_FROM",
            "RECEIVED_FROM",
            "SUPPLEMENTS",
            "CONTAINS",
            "EXPRESSES"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {"type": "string"}
        },
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "created_by": {"type": "string", "minLength": 1},
        "created_at": {"type": "integer", "minimum": 0},
        "reversible": {"type": "boolean"},
        "integrity_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "payload": {"type": "object"}
      },
      "additionalProperties": false
    }
  }
}
