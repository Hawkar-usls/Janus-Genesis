    "POST != UNIVERSAL EFFECT",
    "API ALIAS != ARBITRARY URL",
    "IDEMPOTENCY KEY != EXACTLY-ONCE PROOF",
    "AMBIGUITY != RETRY CONSENT",
    "NETWORK ACCESS != CREDENTIAL ACCESS"
