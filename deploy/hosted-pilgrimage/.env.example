# Generate with a secret manager. Never commit the real value.
GENESIS_HOSTED_SECRET=replace-with-at-least-32-random-bytes

# Set only after an HTTPS reverse proxy is working.
GENESIS_PUBLIC_BASE_URL=

# Safe defaults. Enable live mode and disable the kill switch only after tests.
GENESIS_HOSTED_LIVE_MODE=false
GENESIS_HOSTED_KILL_SWITCH=true
GENESIS_HOSTED_PORT=8787

GENESIS_HOSTED_TOKEN_TTL_SECONDS=900
GENESIS_HOSTED_GLOBAL_LIMIT_PER_MINUTE=120
GENESIS_HOSTED_CLIENT_LIMIT_PER_MINUTE=30
GENESIS_HOSTED_SESSION_LIMIT_PER_MINUTE=20
